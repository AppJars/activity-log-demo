<Configuration packages="com.appjars.activitylog.business.service" status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
    </Console>
    <ActivityLogAppender name="ActivityLogAppender" bufferCapacity="10000" bufferLevel="DEBUG"/>
  </Appenders>
  <Loggers>
    <Root level="trace" additivity="false">
      <AppenderRef ref="Console" level="info"/>
      <AppenderRef ref="ActivityLogAppender" level="trace"/>      
    </Root>
  </Loggers>
</Configuration>
